---
import { GITHUB_URL, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="logo" href="/"><span class="orb" aria-hidden="true"></span>{SITE_TITLE}</a>
		<div class="links">
			<HeaderLink href="/blog">글</HeaderLink>
			<HeaderLink href="/tags">태그</HeaderLink>
			<HeaderLink href="/about">소개</HeaderLink>
			<a class="icon" href={GITHUB_URL} target="_blank" rel="noopener" aria-label="GitHub">
				<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
					<path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: var(--bg-blur);
		backdrop-filter: blur(14px) saturate(140%);
		-webkit-backdrop-filter: blur(14px) saturate(140%);
		border-bottom: 1px solid var(--border);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1040px;
		margin: 0 auto;
		padding: 0.7em 1.25em;
	}
	.logo {
		display: inline-flex;
		align-items: center;
		gap: 0.55em;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.15em;
		letter-spacing: -0.01em;
		color: #fff;
		text-decoration: none;
	}
	.logo:hover {
		color: #fff;
	}
	.orb {
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background: radial-gradient(circle at 30% 30%, #fff, #a78bfa 45%, #4c1d95 100%);
		box-shadow:
			0 0 12px rgba(167, 139, 250, 0.9),
			0 0 28px rgba(34, 211, 238, 0.35);
	}
	.links {
		display: flex;
		align-items: center;
		gap: 0.25em;
		font-size: 0.92em;
	}
	.icon {
		display: inline-flex;
		padding: 0.45em;
		color: var(--text-muted);
	}
	.icon:hover {
		color: #fff;
	}
</style>
