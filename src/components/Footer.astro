---
import { AUTHOR, GITHUB_URL } from '../consts';
const today = new Date();
---

<footer>
	<p>
		&copy; {today.getFullYear()} {AUTHOR}
		<span>·</span>
		<a href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a>
		<span>·</span>
		<a href="/rss.xml">RSS</a>
	</p>
</footer>
<style>
	footer {
		padding: 2em 1em 4em;
		color: var(--text-muted);
		text-align: center;
		font-size: 0.85em;
		border-top: 1px solid var(--border);
	}
	a {
		color: inherit;
	}
</style>
