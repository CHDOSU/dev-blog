---
// 화면 전체에 깔리는 별 배경. 별이 반짝이고, 가끔 유성이 지나갑니다.
// 움직임 줄이기 설정을 켠 사용자에게는 정지된 별만 그립니다.
---

<div class="space" aria-hidden="true">
	<div class="nebula"></div>
	<canvas id="starfield"></canvas>
</div>

<script>
	const canvas = document.getElementById('starfield') as HTMLCanvasElement;
	const ctx = canvas.getContext('2d')!;
	const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
	const COLORS = ['255,255,255', '200,215,255', '255,235,210', '190,170,255'];

	type Star = { x: number; y: number; r: number; a: number; s: number; p: number; c: string };
	type Meteor = { x: number; y: number; vx: number; vy: number; life: number };
	let stars: Star[] = [];
	let meteor: Meteor | null = null;
	let w = 0;
	let h = 0;

	function resize() {
		const dpr = Math.min(devicePixelRatio || 1, 2);
		w = innerWidth;
		h = innerHeight;
		canvas.width = w * dpr;
		canvas.height = h * dpr;
		canvas.style.width = w + 'px';
		canvas.style.height = h + 'px';
		ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
		const count = Math.min(400, Math.floor((w * h) / 3500));
		stars = Array.from({ length: count }, () => ({
			x: Math.random() * w,
			y: Math.random() * h,
			r: Math.random() < 0.92 ? Math.random() * 0.9 + 0.2 : Math.random() * 1.4 + 0.9,
			a: Math.random() * 0.6 + 0.3,
			s: Math.random() * 0.02 + 0.005,
			p: Math.random() * Math.PI * 2,
			c: COLORS[Math.floor(Math.random() * COLORS.length)],
		}));
	}

	function draw(t: number) {
		ctx.clearRect(0, 0, w, h);
		const scroll = scrollY * 0.05; // 아주 약한 시차 효과
		for (const st of stars) {
			const tw = reduced ? 1 : 0.6 + 0.4 * Math.sin(t * st.s * 0.06 + st.p);
			const y = (((st.y - scroll * st.r) % h) + h) % h;
			ctx.beginPath();
			ctx.arc(st.x, y, st.r, 0, Math.PI * 2);
			ctx.fillStyle = `rgba(${st.c},${st.a * tw})`;
			if (st.r > 1.2) {
				ctx.shadowBlur = 8;
				ctx.shadowColor = `rgba(${st.c},0.8)`;
			}
			ctx.fill();
			ctx.shadowBlur = 0;
		}
		if (!reduced) {
			if (!meteor && Math.random() < 0.0025) {
				meteor = { x: Math.random() * w * 0.7 + w * 0.3, y: Math.random() * h * 0.4, vx: -7, vy: 3.2, life: 1 };
			}
			if (meteor) {
				const m = meteor;
				const g = ctx.createLinearGradient(m.x, m.y, m.x - m.vx * 14, m.y - m.vy * 14);
				g.addColorStop(0, `rgba(255,255,255,${m.life})`);
				g.addColorStop(1, 'rgba(160,140,255,0)');
				ctx.strokeStyle = g;
				ctx.lineWidth = 1.5;
				ctx.beginPath();
				ctx.moveTo(m.x, m.y);
				ctx.lineTo(m.x - m.vx * 14, m.y - m.vy * 14);
				ctx.stroke();
				m.x += m.vx;
				m.y += m.vy;
				m.life -= 0.012;
				if (m.life <= 0 || m.x < -100 || m.y > h + 100) meteor = null;
			}
			requestAnimationFrame(draw);
		}
	}

	resize();
	addEventListener('resize', () => {
		resize();
		if (reduced) draw(0);
	});
	if (reduced) addEventListener('scroll', () => draw(0), { passive: true });
	requestAnimationFrame(draw);
</script>

<style>
	.space {
		position: fixed;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		background: var(--bg);
	}
	.nebula {
		position: absolute;
		inset: -20%;
		background:
			radial-gradient(40% 35% at 15% 10%, rgba(124, 58, 237, 0.22), transparent 70%),
			radial-gradient(35% 30% at 85% 20%, rgba(34, 211, 238, 0.12), transparent 70%),
			radial-gradient(45% 40% at 70% 85%, rgba(236, 72, 153, 0.12), transparent 70%),
			radial-gradient(30% 30% at 20% 75%, rgba(59, 130, 246, 0.12), transparent 70%);
		filter: blur(20px);
		animation: drift 60s ease-in-out infinite alternate;
	}
	canvas {
		position: absolute;
		inset: 0;
	}
	@keyframes drift {
		from {
			transform: translate3d(0, 0, 0) scale(1);
		}
		to {
			transform: translate3d(-3%, 2%, 0) scale(1.08);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.nebula {
			animation: none;
		}
	}
</style>
